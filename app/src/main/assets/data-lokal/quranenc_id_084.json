{"result":[{"id":"5885","sura":"84","aya":"1","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u06e1","translation":"Apabila langit terbelah,","footnotes":""},{"id":"5886","sura":"84","aya":"2","arabic_text":"\u0648\u064e\u0623\u064e\u0630\u0650\u0646\u064e\u062a\u06e1 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0648\u064e\u062d\u064f\u0642\u0651\u064e\u062a\u06e1","translation":"dan patuh kepada Tuhannya, dan sudah semestinya patuh,","footnotes":""},{"id":"5887","sura":"84","aya":"3","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u0645\u064f\u062f\u0651\u064e\u062a\u06e1","translation":"dan apabila bumi diratakan,","footnotes":""},{"id":"5888","sura":"84","aya":"4","arabic_text":"\u0648\u064e\u0623\u064e\u0644\u06e1\u0642\u064e\u062a\u06e1 \u0645\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u062a\u064e\u062e\u064e\u0644\u0651\u064e\u062a\u06e1","translation":"dan memuntahkan apa yang ada di dalamnya dan menjadi kosong,","footnotes":""},{"id":"5889","sura":"84","aya":"5","arabic_text":"\u0648\u064e\u0623\u064e\u0630\u0650\u0646\u064e\u062a\u06e1 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0648\u064e\u062d\u064f\u0642\u0651\u064e\u062a\u06e1","translation":"dan patuh kepada Tuhannya, dan sudah semestinya patuh.","footnotes":""},{"id":"5890","sura":"84","aya":"6","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0643\u064e\u0627\u062f\u0650\u062d\u064c \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0643\u064e\u062f\u06e1\u062d\u0657\u0627 \u0641\u064e\u0645\u064f\u0644\u064e\u0670\u0642\u0650\u064a\u0647\u0650","translation":"Wahai manusia! Sesungguhnya kamu telah bekerja keras menuju Tuhanmu, maka kamu akan menemui-Nya.[903]","footnotes":"[903] Manusia di dunia ini baik disadari atau tidak adalah dalam perjalanan kepada Tuhannya. Dan pasti dia akan menemui Tuhannya untuk menerima pembalasan-Nya dari perbuatannya yang buruk maupun yang baik."},{"id":"5891","sura":"84","aya":"7","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u064a\u064e\u0645\u0650\u064a\u0646\u0650\u0647\u0650\u06e6","translation":"Maka adapun orang yang catatanya diberikan dari sebelah kanannya,","footnotes":""},{"id":"5892","sura":"84","aya":"8","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u062d\u064e\u0627\u0633\u064e\u0628\u064f \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627 \u064a\u064e\u0633\u0650\u064a\u0631\u0657\u0627","translation":"maka dia akan diperiksa dengan pemeriksaan yang mudah,","footnotes":""},{"id":"5893","sura":"84","aya":"9","arabic_text":"\u0648\u064e\u064a\u064e\u0646\u0642\u064e\u0644\u0650\u0628\u064f \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u0657\u0627","translation":"dan dia akan kembali kepada keluarganya (yang sama-sama beriman) dengan gembira.","footnotes":""},{"id":"5894","sura":"84","aya":"10","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0638\u064e\u0647\u06e1\u0631\u0650\u0647\u0650\u06e6","translation":"Dan adapun orang yang catatannya diberikan dari arah belakang,","footnotes":""},{"id":"5895","sura":"84","aya":"11","arabic_text":"\u0641\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u062b\u064f\u0628\u064f\u0648\u0631\u0657\u0627","translation":"maka dia akan berteriak, \"Celakalah aku!\"","footnotes":""},{"id":"5896","sura":"84","aya":"12","arabic_text":"\u0648\u064e\u064a\u064e\u0635\u06e1\u0644\u064e\u0649\u0670 \u0633\u064e\u0639\u0650\u064a\u0631\u064b\u0627","translation":"Dan dia akan masuk ke dalam api yang menyala-nyala (neraka).","footnotes":""},{"id":"5897","sura":"84","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0645\u064e\u0633\u06e1\u0631\u064f\u0648\u0631\u064b\u0627","translation":"Sungguh, dia dahulu (di dunia) bergembira di kalangan keluarganya (yang sama-sama kafir).","footnotes":""},{"id":"5898","sura":"84","aya":"14","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0638\u064e\u0646\u0651\u064e \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u062d\u064f\u0648\u0631\u064e","translation":"Sesungguhnya dia mengira bahwa dia tidak akan kembali (kepada Tuhannya).","footnotes":""},{"id":"5899","sura":"84","aya":"15","arabic_text":"\u0628\u064e\u0644\u064e\u0649\u0670\u0653\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0628\u0650\u0647\u0650\u06e6 \u0628\u064e\u0635\u0650\u064a\u0631\u0657\u0627","translation":"Tidak demikian, sesungguhnya Tuhannya selalu melihatnya.","footnotes":""},{"id":"5900","sura":"84","aya":"16","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u0634\u0651\u064e\u0641\u064e\u0642\u0650","translation":"Maka Aku bersumpah demi cahaya merah pada waktu senja,","footnotes":""},{"id":"5901","sura":"84","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0648\u064e\u0645\u064e\u0627 \u0648\u064e\u0633\u064e\u0642\u064e","translation":"demi malam dan apa yang diselubunginya,","footnotes":""},{"id":"5902","sura":"84","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650 \u0625\u0650\u0630\u064e\u0627 \u0671\u062a\u0651\u064e\u0633\u064e\u0642\u064e","translation":"demi bulan apabila jadi purnama,","footnotes":""},{"id":"5903","sura":"84","aya":"19","arabic_text":"\u0644\u064e\u062a\u064e\u0631\u06e1\u0643\u064e\u0628\u064f\u0646\u0651\u064e \u0637\u064e\u0628\u064e\u0642\u064b\u0627 \u0639\u064e\u0646 \u0637\u064e\u0628\u064e\u0642\u0656","translation":"sungguh, akan kamu jalani tingkat demi tingkat (dalam kehidupan).[904]","footnotes":"[904] Dari setetes mani sampai dilahirkan, kemudian melalui masa kanak-kanak, remaja dan sampai dewasa. Dari hidup menjadi mati kemudian dibangkitkan kembali."},{"id":"5904","sura":"84","aya":"20","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Maka mengapa mereka tidak mau beriman?","footnotes":""},{"id":"5905","sura":"84","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0631\u0650\u0626\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064f \u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0646\u064e\u06e4\u06e9","translation":"Dan apabila Al-Qur`an dibacakan kepada mereka, mereka tidak (mau) bersujud,","footnotes":""},{"id":"5906","sura":"84","aya":"22","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"bahkan orang-orang kafir itu mendustakan-(nya).","footnotes":""},{"id":"5907","sura":"84","aya":"23","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064f\u0648\u0646\u064e","translation":"Dan Allah lebih mengetahui apa yang mereka sembunyikan (dalam hati mereka).","footnotes":""},{"id":"5908","sura":"84","aya":"24","arabic_text":"\u0641\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u06e1\u0647\u064f\u0645 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","translation":"Maka sampaikanlah kepada mereka (ancaman) azab yang pedih,","footnotes":""},{"id":"5909","sura":"84","aya":"25","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064c \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0646\u0650\u06ed","translation":"kecuali orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat pahala yang tidak putus-putusnya.","footnotes":""}]}