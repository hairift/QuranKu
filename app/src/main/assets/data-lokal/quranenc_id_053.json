{"result":[{"id":"4785","sura":"53","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u0645\u0650 \u0625\u0650\u0630\u064e\u0627 \u0647\u064e\u0648\u064e\u0649\u0670","translation":"Demi bintang ketika terbenam,","footnotes":""},{"id":"4786","sura":"53","aya":"2","arabic_text":"\u0645\u064e\u0627 \u0636\u064e\u0644\u0651\u064e \u0635\u064e\u0627\u062d\u0650\u0628\u064f\u0643\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u063a\u064e\u0648\u064e\u0649\u0670","translation":"kawanmu (Muhammad) tidak sesat dan tidak (pula) keliru,","footnotes":""},{"id":"4787","sura":"53","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f \u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0647\u064e\u0648\u064e\u0649\u0670\u0653","translation":"dan tidaklah yang diucapkannya itu (Al-Qur`an) menurut keinginannya.","footnotes":""},{"id":"4788","sura":"53","aya":"4","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0648\u064e\u062d\u06e1\u064a\u065e \u064a\u064f\u0648\u062d\u064e\u0649\u0670","translation":"Tidak lain (Al-Qur`an itu) adalah wahyu yang diwahyukan (kepadanya),","footnotes":""},{"id":"4789","sura":"53","aya":"5","arabic_text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e\u0647\u064f\u06e5 \u0634\u064e\u062f\u0650\u064a\u062f\u064f \u0671\u0644\u06e1\u0642\u064f\u0648\u064e\u0649\u0670","translation":"yang diajarkan kepadanya oleh (Jibril) yang sangat kuat,","footnotes":""},{"id":"4790","sura":"53","aya":"6","arabic_text":"\u0630\u064f\u0648 \u0645\u0650\u0631\u0651\u064e\u0629\u0656 \u0641\u064e\u0671\u0633\u06e1\u062a\u064e\u0648\u064e\u0649\u0670","translation":"yang mempunyai keteguhan; maka (Jibril itu) menampakkan diri dengan rupa yang asli (rupa yang bagus dan perkasa)","footnotes":""},{"id":"4791","sura":"53","aya":"7","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u064f\u0641\u064f\u0642\u0650 \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0649\u0670","translation":"Sedang dia berada di ufuk yang tinggi.","footnotes":""},{"id":"4792","sura":"53","aya":"8","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u062f\u064e\u0646\u064e\u0627 \u0641\u064e\u062a\u064e\u062f\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Kemudian dia mendekat (pada Muhammad), lalu bertambah dekat,","footnotes":""},{"id":"4793","sura":"53","aya":"9","arabic_text":"\u0641\u064e\u0643\u064e\u0627\u0646\u064e \u0642\u064e\u0627\u0628\u064e \u0642\u064e\u0648\u06e1\u0633\u064e\u064a\u06e1\u0646\u0650 \u0623\u064e\u0648\u06e1 \u0623\u064e\u062f\u06e1\u0646\u064e\u0649\u0670","translation":"sehingga jaraknya (sekitar) dua busur panah atau lebih dekat (lagi).","footnotes":""},{"id":"4794","sura":"53","aya":"10","arabic_text":"\u0641\u064e\u0623\u064e\u0648\u06e1\u062d\u064e\u0649\u0670\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0639\u064e\u0628\u06e1\u062f\u0650\u0647\u0650\u06e6 \u0645\u064e\u0627\u0653 \u0623\u064e\u0648\u06e1\u062d\u064e\u0649\u0670","translation":"Lalu disampaikannya wahyu kepada hamba-Nya (Muhammad) apa yang telah diwahyukan Allah.","footnotes":""},{"id":"4795","sura":"53","aya":"11","arabic_text":"\u0645\u064e\u0627 \u0643\u064e\u0630\u064e\u0628\u064e \u0671\u0644\u06e1\u0641\u064f\u0624\u064e\u0627\u062f\u064f \u0645\u064e\u0627 \u0631\u064e\u0623\u064e\u0649\u0670\u0653","translation":"Hatinya tidak mendustakan apa yang telah dilihatnya.","footnotes":""},{"id":"4796","sura":"53","aya":"12","arabic_text":"\u0623\u064e\u0641\u064e\u062a\u064f\u0645\u064e\u0670\u0631\u064f\u0648\u0646\u064e\u0647\u064f\u06e5 \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u064a\u064e\u0631\u064e\u0649\u0670","translation":"Maka apakah kamu (musyrikin Mekkah) hendak membantahnya tentang apa yang dilihatnya itu?","footnotes":""},{"id":"4797","sura":"53","aya":"13","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0621\u064e\u0627\u0647\u064f \u0646\u064e\u0632\u06e1\u0644\u064e\u0629\u064b \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"Dan sungguh, dia (Muhammad) telah melihatnya (dalam rupanya yang asli) pada waktu yang lain,","footnotes":""},{"id":"4798","sura":"53","aya":"14","arabic_text":"\u0639\u0650\u0646\u062f\u064e \u0633\u0650\u062f\u06e1\u0631\u064e\u0629\u0650 \u0671\u0644\u06e1\u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670","translation":"(yaitu) di Sidratilmuntah\u0101,[817]","footnotes":"[817] Sidratilmuntah\u0101 yaitu tempat yang paling atas pada langit yang ke-7, yang telah dikunjungi Nabi -\u1e63allall\u0101hu 'alaihi wa sallam- ketika Mi'raj."},{"id":"4799","sura":"53","aya":"15","arabic_text":"\u0639\u0650\u0646\u062f\u064e\u0647\u064e\u0627 \u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670\u0653","translation":"di dekatnya ada surga tempat tinggal,","footnotes":""},{"id":"4800","sura":"53","aya":"16","arabic_text":"\u0625\u0650\u0630\u06e1 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649 \u0671\u0644\u0633\u0651\u0650\u062f\u06e1\u0631\u064e\u0629\u064e \u0645\u064e\u0627 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649\u0670","translation":"(Muhammad melihat Jibril) ketika Sidratilmuntah\u0101 diliputi oleh sesuatu yang meliputinya,","footnotes":""},{"id":"4801","sura":"53","aya":"17","arabic_text":"\u0645\u064e\u0627 \u0632\u064e\u0627\u063a\u064e \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064f \u0648\u064e\u0645\u064e\u0627 \u0637\u064e\u063a\u064e\u0649\u0670","translation":"penglihatannya (Muhammad) tidak menyimpang dari yang dilihatnya itu dan tidak (pula) melampauinya.","footnotes":""},{"id":"4802","sura":"53","aya":"18","arabic_text":"\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0623\u064e\u0649\u0670 \u0645\u0650\u0646\u06e1 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"Sungguh, dia telah melihat sebagian tanda-tanda (kebesaran) Tuhannya yang paling besar.","footnotes":""},{"id":"4803","sura":"53","aya":"19","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0670\u062a\u064e \u0648\u064e\u0671\u0644\u06e1\u0639\u064f\u0632\u0651\u064e\u0649\u0670","translation":"Maka apakah patut kamu (orang-orang musyrik) menganggap (berhala) Al-L\u0101ta dan Al-'Uzz\u0101,","footnotes":""},{"id":"4804","sura":"53","aya":"20","arabic_text":"\u0648\u064e\u0645\u064e\u0646\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062b\u0651\u064e\u0627\u0644\u0650\u062b\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"dan Man\u0101t, yang ketiga yang paling kemudian (sebagai anak perempuan Allah).","footnotes":""},{"id":"4805","sura":"53","aya":"21","arabic_text":"\u0623\u064e\u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Apakah (pantas) untuk kamu yang laki-laki dan untuk-Nya yang perempuan?","footnotes":""},{"id":"4806","sura":"53","aya":"22","arabic_text":"\u062a\u0650\u0644\u06e1\u0643\u064e \u0625\u0650\u0630\u0657\u0627 \u0642\u0650\u0633\u06e1\u0645\u064e\u0629\u065e \u0636\u0650\u064a\u0632\u064e\u0649\u0670\u0653","translation":"Yang demikian itu tentulah suatu pembagian yang timpang.","footnotes":""},{"id":"4807","sura":"53","aya":"23","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0645\u064e\u0627\u0653\u0621\u065e \u0633\u064e\u0645\u0651\u064e\u064a\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0643\u064f\u0645 \u0645\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0632\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646 \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u064d\u06da \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0647\u06e1\u0648\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0646\u0641\u064f\u0633\u064f\u06d6 \u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"Itu tidak lain hanyalah nama-nama yang kamu dan nenek moyangmu mengada-adakannya; Allah tidak menurunkan suatu keterangan apa pun untuk (menyembah)nya. Mereka hanya mengikuti dugaan, dan apa yang diingini oleh keinginannya. Padahal sungguh, telah datang petunjuk dari Tuhan mereka.","footnotes":""},{"id":"4808","sura":"53","aya":"24","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0645\u064e\u0627 \u062a\u064e\u0645\u064e\u0646\u0651\u064e\u0649\u0670","translation":"Atau apakah manusia akan mendapat segala yang dicita-citakannya?","footnotes":""},{"id":"4809","sura":"53","aya":"25","arabic_text":"\u0641\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"(Tidak!) Maka milik Allah lah kehidupan akhirat dan kehidupan dunia.","footnotes":""},{"id":"4810","sura":"53","aya":"26","arabic_text":"\u06de\u00a0\u0648\u064e\u0643\u064e\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0644\u064e\u0643\u0656 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0644\u064e\u0627 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u062a\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u06e1\u0630\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670\u0653","translation":"Dan betapa banyak malaikat di langit, syafaat (pertolongan) mereka sedikit pun tidak berguna kecuali apabila Allah telah mengizinkan (dan hanya) bagi siapa yang Dia kehendaki dan Dia ridai.","footnotes":""},{"id":"4811","sura":"53","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u0633\u064e\u0645\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064e \u062a\u064e\u0633\u06e1\u0645\u0650\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Sesungguhnya orang-orang yang tidak beriman kepada kehidupan akhirat, sungguh mereka menamakan para malaikat dengan nama perempuan.","footnotes":""},{"id":"4812","sura":"53","aya":"28","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u064d\u06d6 \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e\u06d6 \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627","translation":"Dan mereka tidak mempunyai ilmu tentang itu. Mereka tidak lain hanyalah mengikuti dugaan, dan sesungguhnya dugaan itu tidak berfaedah sedikit pun terhadap kebenaran.","footnotes":""},{"id":"4813","sura":"53","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0645\u0651\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064f\u0631\u0650\u062f\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"Maka tinggalkanlah (Muhammad) orang yang berpaling dari peringatan Kami, dan dia hanya mengingini kehidupan dunia.","footnotes":""},{"id":"4814","sura":"53","aya":"30","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u0647\u06e1\u062a\u064e\u062f\u064e\u0649\u0670","translation":"Itulah kadar ilmu mereka. Sungguh, Tuhanmu, Dia lebih mengetahui siapa yang tersesat dari jalan-Nya dan Dia pula yang lebih mengetahui siapa yang mendapat petunjuk.","footnotes":""},{"id":"4815","sura":"53","aya":"31","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0644\u0650\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0633\u064e\u0670\u0653\u0640\u0654\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649","translation":"Dan milik Allah lah apa yang ada di langit dan apa yang ada di bumi. (Dengan demikian) Dia akan memberi balasan kepada orang-orang yang berbuat jahat sesuai dengan apa yang telah mereka kerjakan, dan Dia akan memberi balasan kepada orang-orang yang berbuat baik dengan pahala yang lebih baik (surga).","footnotes":""},{"id":"4816","sura":"53","aya":"32","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062c\u06e1\u062a\u064e\u0646\u0650\u0628\u064f\u0648\u0646\u064e \u0643\u064e\u0628\u064e\u0670\u0653\u0626\u0650\u0631\u064e \u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u0648\u064e\u0670\u062d\u0650\u0634\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0645\u064e\u0645\u064e\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0648\u064e\u0670\u0633\u0650\u0639\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u062c\u0650\u0646\u0651\u064e\u0629\u065e \u0641\u0650\u064a \u0628\u064f\u0637\u064f\u0648\u0646\u0650 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0632\u064e\u0643\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670\u0653","translation":"(Yaitu) mereka yang menjauhi dosa-dosa besar dan perbuatan keji, kecuali kesalahan-kesalahan kecil. Sungguh, Tuhanmu Mahaluas ampunan-Nya. Dia mengetahui tentang kamu, sejak Dia menjadikan kamu dari tanah lalu ketika kamu masih janin dalam perut ibumu. Maka janganlah kamu menganggap dirimu suci. Dia mengetahui tentang orang yang bertakwa.","footnotes":""},{"id":"4817","sura":"53","aya":"33","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Maka tidakkah engkau melihat orang yang berpaling (dari Al-Qur`an)?","footnotes":""},{"id":"4818","sura":"53","aya":"34","arabic_text":"\u0648\u064e\u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0648\u064e\u0623\u064e\u0643\u06e1\u062f\u064e\u0649\u0670\u0653","translation":"dan dia memberikan sedikit (dari apa yang dijanjikan) lalu menahan sisanya.","footnotes":""},{"id":"4819","sura":"53","aya":"35","arabic_text":"\u0623\u064e\u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0639\u0650\u0644\u06e1\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u0631\u064e\u0649\u0670\u0653","translation":"Apakah dia mempunyai ilmu tentang yang gaib sehingga dia dapat melihat(nya)?","footnotes":""},{"id":"4820","sura":"53","aya":"36","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0623\u06e1 \u0628\u0650\u0645\u064e\u0627 \u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0650 \u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"Ataukah belum diberitakan (kepadanya) apa yang ada dalam lembaran-lembaran (Kitab Suci yang diturunkan kepada) Musa?","footnotes":""},{"id":"4821","sura":"53","aya":"37","arabic_text":"\u0648\u064e\u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0648\u064e\u0641\u0651\u064e\u0649\u0670\u0653","translation":"Dan (lembaran-lembaran) Ibrahim yang selalu menyempurnakan janji?","footnotes":""},{"id":"4822","sura":"53","aya":"38","arabic_text":"\u0623\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0632\u0650\u0631\u064f \u0648\u064e\u0627\u0632\u0650\u0631\u064e\u0629\u065e \u0648\u0650\u0632\u06e1\u0631\u064e \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"(yaitu) bahwa seseorang yang berdosa tidak akan memikul dosa orang lain,","footnotes":""},{"id":"4823","sura":"53","aya":"39","arabic_text":"\u0648\u064e\u0623\u064e\u0646 \u0644\u0651\u064e\u064a\u06e1\u0633\u064e \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"dan bahwa manusia hanya memperoleh apa yang telah diusahakannya,","footnotes":""},{"id":"4824","sura":"53","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0633\u064e\u0639\u06e1\u064a\u064e\u0647\u064f\u06e5 \u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u0631\u064e\u0649\u0670","translation":"dan sesungguhnya usahanya itu kelak akan diperlihatkan (kepadanya),","footnotes":""},{"id":"4825","sura":"53","aya":"41","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u06e1\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u0641\u064e\u0649\u0670","translation":"kemudian akan diberi balasan kepadanya dengan balasan yang paling sempurna,","footnotes":""},{"id":"4826","sura":"53","aya":"42","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670","translation":"dan sesungguhnya kepada Tuhanmulah kesudahannya (segala sesuatu),","footnotes":""},{"id":"4827","sura":"53","aya":"43","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0636\u06e1\u062d\u064e\u0643\u064e \u0648\u064e\u0623\u064e\u0628\u06e1\u0643\u064e\u0649\u0670","translation":"dan sesungguhnya Dialah yang menjadikan orang tertawa dan menangis,","footnotes":""},{"id":"4828","sura":"53","aya":"44","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e \u0648\u064e\u0623\u064e\u062d\u06e1\u064a\u064e\u0627","translation":"dan sesungguhnya Dialah yang mematikan dan menghidupkan,","footnotes":""},{"id":"4829","sura":"53","aya":"45","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"dan sesungguhnya Dialah yang menciptakan pasangan laki-laki dan perempuan,","footnotes":""},{"id":"4830","sura":"53","aya":"46","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u0625\u0650\u0630\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"dari mani, apabila dipancarkan,","footnotes":""},{"id":"4831","sura":"53","aya":"47","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"dan sesungguhnya Dialah yang menetapkan penciptaan yang lain (kebangkitan setelah mati),","footnotes":""},{"id":"4832","sura":"53","aya":"48","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0642\u06e1\u0646\u064e\u0649\u0670","translation":"dan sesungguhnya Dialah yang memberikan kekayaan dan kecukupan.","footnotes":""},{"id":"4833","sura":"53","aya":"49","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u0634\u0651\u0650\u0639\u06e1\u0631\u064e\u0649\u0670","translation":"dan sesungguhnya Dialah Tuhan (yang memiliki) bintang Syi'r\u0101,[818]","footnotes":"[818] Bintang yang disembah oleh orang-orang Arab pada masa Jahiliah."},{"id":"4834","sura":"53","aya":"50","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u064e \u0639\u064e\u0627\u062f\u064b\u0627 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"dan sesungguhnya Dialah yang telah membinasakan kaum '\u0100d dahulu kala,","footnotes":""},{"id":"4835","sura":"53","aya":"51","arabic_text":"\u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e\u0627\u0652 \u0641\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0628\u06e1\u0642\u064e\u0649\u0670","translation":"dan kaum Samud, tidak seorang pun yang ditinggalkan-Nya (hidup),","footnotes":""},{"id":"4836","sura":"53","aya":"52","arabic_text":"\u0648\u064e\u0642\u064e\u0648\u06e1\u0645\u064e \u0646\u064f\u0648\u062d\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0647\u064f\u0645\u06e1 \u0623\u064e\u0638\u06e1\u0644\u064e\u0645\u064e \u0648\u064e\u0623\u064e\u0637\u06e1\u063a\u064e\u0649\u0670","translation":"dan (juga) kaum Nuh sebelum itu. Sungguh, mereka adalah orang-orang yang paling zalim dan paling durhaka.","footnotes":""},{"id":"4837","sura":"53","aya":"53","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u062a\u064e\u0641\u0650\u0643\u064e\u0629\u064e \u0623\u064e\u0647\u06e1\u0648\u064e\u0649\u0670","translation":"Dan prahara angin telah meruntuhkan (negeri kaum Lu\u1e6d),","footnotes":""},{"id":"4838","sura":"53","aya":"54","arabic_text":"\u0641\u064e\u063a\u064e\u0634\u0651\u064e\u0649\u0670\u0647\u064e\u0627 \u0645\u064e\u0627 \u063a\u064e\u0634\u0651\u064e\u0649\u0670","translation":"lalu menimbuni negeri itu (sebagai azab) dengan (puing-puing) yang menimpanya.","footnotes":""},{"id":"4839","sura":"53","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u062a\u064e\u062a\u064e\u0645\u064e\u0627\u0631\u064e\u0649\u0670","translation":"Maka terhadap nikmat Tuhanmu yang manakah yang masih kamu ragukan?","footnotes":""},{"id":"4840","sura":"53","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670\u0653","translation":"Ini (Muhammad) salah seorang pemberi peringatan di antara para pemberi peringatan yang telah terdahulu.","footnotes":""},{"id":"4841","sura":"53","aya":"57","arabic_text":"\u0623\u064e\u0632\u0650\u0641\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u0653\u0632\u0650\u0641\u064e\u0629\u064f","translation":"Yang dekat (hari Kiamat) telah makin mendekat.","footnotes":""},{"id":"4842","sura":"53","aya":"58","arabic_text":"\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064e\u0627 \u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0627\u0634\u0650\u0641\u064e\u0629\u064c","translation":"Tidak ada yang akan dapat mengungkapkan (terjadinya hari itu) selain Allah.","footnotes":""},{"id":"4843","sura":"53","aya":"59","arabic_text":"\u0623\u064e\u0641\u064e\u0645\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u062a\u064e\u0639\u06e1\u062c\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Maka apakah kamu merasa heran terhadap pemberitaan ini?","footnotes":""},{"id":"4844","sura":"53","aya":"60","arabic_text":"\u0648\u064e\u062a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0628\u06e1\u0643\u064f\u0648\u0646\u064e","translation":"dan kamu tertawakan dan tidak menangis,","footnotes":""},{"id":"4845","sura":"53","aya":"61","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0633\u064e\u0670\u0645\u0650\u062f\u064f\u0648\u0646\u064e","translation":"sedang kamu lengah (darinya).","footnotes":""},{"id":"4846","sura":"53","aya":"62","arabic_text":"\u0641\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0627\u0652\u06e4 \u0644\u0650\u0644\u0651\u064e\u0647\u0650\u06e4 \u0648\u064e\u0671\u0639\u06e1\u0628\u064f\u062f\u064f\u0648\u0627\u0652\u06e9","translation":"Maka bersujudlah kepada Allah dan sembahlah (Dia)!","footnotes":""}]}