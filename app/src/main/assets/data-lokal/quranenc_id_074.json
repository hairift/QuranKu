{"result":[{"id":"5496","sura":"74","aya":"1","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u062f\u0651\u064e\u062b\u0651\u0650\u0631\u064f","translation":"Wahai orang yang berkemul (berselimut)!","footnotes":""},{"id":"5497","sura":"74","aya":"2","arabic_text":"\u0642\u064f\u0645\u06e1 \u0641\u064e\u0623\u064e\u0646\u0630\u0650\u0631\u06e1","translation":"Bangunlah, lalu berilah peringatan!","footnotes":""},{"id":"5498","sura":"74","aya":"3","arabic_text":"\u0648\u064e\u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0641\u064e\u0643\u064e\u0628\u0651\u0650\u0631\u06e1","translation":"Dan agungkanlah Tuhanmu,","footnotes":""},{"id":"5499","sura":"74","aya":"4","arabic_text":"\u0648\u064e\u062b\u0650\u064a\u064e\u0627\u0628\u064e\u0643\u064e \u0641\u064e\u0637\u064e\u0647\u0651\u0650\u0631\u06e1","translation":"dan bersihkanlah pakaianmu,","footnotes":""},{"id":"5500","sura":"74","aya":"5","arabic_text":"\u0648\u064e\u0671\u0644\u0631\u0651\u064f\u062c\u06e1\u0632\u064e \u0641\u064e\u0671\u0647\u06e1\u062c\u064f\u0631\u06e1","translation":"dan tinggalkanlah segala (perbuatan) yang keji,","footnotes":""},{"id":"5501","sura":"74","aya":"6","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0645\u06e1\u0646\u064f\u0646 \u062a\u064e\u0633\u06e1\u062a\u064e\u0643\u06e1\u062b\u0650\u0631\u064f","translation":"dan janganlah engkau (Muhammad) memberi (dengan maksud) memperoleh (balasan) yang lebih banyak.","footnotes":""},{"id":"5502","sura":"74","aya":"7","arabic_text":"\u0648\u064e\u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1","translation":"Dan karena Tuhanmu, bersabarlah.","footnotes":""},{"id":"5503","sura":"74","aya":"8","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0646\u064f\u0642\u0650\u0631\u064e \u0641\u0650\u064a \u0671\u0644\u0646\u0651\u064e\u0627\u0642\u064f\u0648\u0631\u0650","translation":"Maka apabila sangkakala ditiup,","footnotes":""},{"id":"5504","sura":"74","aya":"9","arabic_text":"\u0641\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u0648\u06e1\u0645\u064c \u0639\u064e\u0633\u0650\u064a\u0631\u064c","translation":"maka itulah hari yang serba sulit,","footnotes":""},{"id":"5505","sura":"74","aya":"10","arabic_text":"\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u063a\u064e\u064a\u06e1\u0631\u064f \u064a\u064e\u0633\u0650\u064a\u0631\u0656","translation":"bagi orang-orang kafir tidak mudah.","footnotes":""},{"id":"5506","sura":"74","aya":"11","arabic_text":"\u0630\u064e\u0631\u06e1\u0646\u0650\u064a \u0648\u064e\u0645\u064e\u0646\u06e1 \u062e\u064e\u0644\u064e\u0642\u06e1\u062a\u064f \u0648\u064e\u062d\u0650\u064a\u062f\u0657\u0627","translation":"Biarkanlah Aku (yang bertindak) terhadap orang yang Aku sendiri telah menciptakannya,[876]","footnotes":"[876] Ayat ini dan beberapa ayat berikutnya diturunkan mengenai seorang kafir Mekkah, pemimpin Quraisy bernama Al-Wal\u012bd bin Mug\u012brah."},{"id":"5507","sura":"74","aya":"12","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u062a\u064f \u0644\u064e\u0647\u064f\u06e5 \u0645\u064e\u0627\u0644\u0657\u0627 \u0645\u0651\u064e\u0645\u06e1\u062f\u064f\u0648\u062f\u0657\u0627","translation":"dan Aku berikan baginya kekayaan yang melimpah,","footnotes":""},{"id":"5508","sura":"74","aya":"13","arabic_text":"\u0648\u064e\u0628\u064e\u0646\u0650\u064a\u0646\u064e \u0634\u064f\u0647\u064f\u0648\u062f\u0657\u0627","translation":"dan anak-anak yang selalu bersamanya,","footnotes":""},{"id":"5509","sura":"74","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0647\u0651\u064e\u062f\u062a\u0651\u064f \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0645\u06e1\u0647\u0650\u064a\u062f\u0657\u0627","translation":"dan Aku berikan baginya kelapangan (hidup) seluas-luasnya.","footnotes":""},{"id":"5510","sura":"74","aya":"15","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0623\u064e\u0646\u06e1 \u0623\u064e\u0632\u0650\u064a\u062f\u064e","translation":"kemudian dia ingin sekali agar Aku menambahnya.","footnotes":""},{"id":"5511","sura":"74","aya":"16","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u0650\u0623\u0653\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0639\u064e\u0646\u0650\u064a\u062f\u0657\u0627","translation":"Tidak bisa! Sesungguhnya dia telah menentang ayat-ayat Kami (Al-Qur`an).","footnotes":""},{"id":"5512","sura":"74","aya":"17","arabic_text":"\u0633\u064e\u0623\u064f\u0631\u06e1\u0647\u0650\u0642\u064f\u0647\u064f\u06e5 \u0635\u064e\u0639\u064f\u0648\u062f\u064b\u0627","translation":"Aku akan membebaninya dengan pendakian yang meletihkan.","footnotes":""},{"id":"5513","sura":"74","aya":"18","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0641\u064e\u0643\u0651\u064e\u0631\u064e \u0648\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),","footnotes":""},{"id":"5514","sura":"74","aya":"19","arabic_text":"\u0641\u064e\u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"maka celakalah dia! Bagaimana dia menetapkan?","footnotes":""},{"id":"5515","sura":"74","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"Ssekali lagi, celakalah dia! Bagaimana dia menetapkan?","footnotes":""},{"id":"5516","sura":"74","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0646\u064e\u0638\u064e\u0631\u064e","translation":"Kemudian dia (merenung) memikirkan,","footnotes":""},{"id":"5517","sura":"74","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u0628\u064e\u0633\u064e\u0631\u064e","translation":"lalu berwajah masam dan cemberut,","footnotes":""},{"id":"5518","sura":"74","aya":"23","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u0648\u064e\u0671\u0633\u06e1\u062a\u064e\u0643\u06e1\u0628\u064e\u0631\u064e","translation":"kemudian berpaling (dari kebenaran) dan menyombongkan diri,","footnotes":""},{"id":"5519","sura":"74","aya":"24","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0633\u0650\u062d\u06e1\u0631\u065e \u064a\u064f\u0624\u06e1\u062b\u064e\u0631\u064f","translation":"lalu dia berkata, \"(Al-Qur`an) ini hanyalah sihir yang dipelajari (dari orang-orang dahulu).","footnotes":""},{"id":"5520","sura":"74","aya":"25","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0642\u064e\u0648\u06e1\u0644\u064f \u0671\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Ini hanyalah perkataan manusia.\"","footnotes":""},{"id":"5521","sura":"74","aya":"26","arabic_text":"\u0633\u064e\u0623\u064f\u0635\u06e1\u0644\u0650\u064a\u0647\u0650 \u0633\u064e\u0642\u064e\u0631\u064e","translation":"Kelak, Aku akan memasukkannya ke dalam (neraka) Saqar,","footnotes":""},{"id":"5522","sura":"74","aya":"27","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0633\u064e\u0642\u064e\u0631\u064f","translation":"Dan tahukah kamu apa (neraka) Saqar itu?","footnotes":""},{"id":"5523","sura":"74","aya":"28","arabic_text":"\u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0642\u0650\u064a \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f","translation":"Ia (Saqar itu) tidak meninggalkan dan tidak membiarkan,[877]","footnotes":"[877] Apa yang dilemparkan ke dalam neraka itu diazabnya sampai binasa kemudian dikembalikannya seperti semula untuk diazab kembali."},{"id":"5524","sura":"74","aya":"29","arabic_text":"\u0644\u064e\u0648\u0651\u064e\u0627\u062d\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"yang menghanguskan kulit manusia.","footnotes":""},{"id":"5525","sura":"74","aya":"30","arabic_text":"\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u062a\u0650\u0633\u06e1\u0639\u064e\u0629\u064e \u0639\u064e\u0634\u064e\u0631\u064e","translation":"Di atasnya ada sembilan belas (malaikat penjaga).","footnotes":""},{"id":"5526","sura":"74","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah menyesatkan orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia.","footnotes":""},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Tidak![878] Demi bulan,","footnotes":"[878] \"Tidak\" adalah bantahan terhadap ucapan-ucapan orang-orang musyrik yang mengingkari hal-hal tersebut di atas."},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"dan demi malam ketika telah berlalu,","footnotes":""},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"dan demi subuh apabila mulai terang,","footnotes":""},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,","footnotes":""},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"sebagai peringatan bagi manusia,","footnotes":""},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur.[879]","footnotes":"[879] Maju menerima peringatan, dan yang dimaksud dengan mundur ialah tidak mau menerima peringatan."},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Setiap orang bertanggung jawab atas apa yang telah dilakukannya,","footnotes":""},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"kecuali golongan kanan,","footnotes":""},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"berada di dalam surga, mereka saling menanyakan,","footnotes":""},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"tentang (keadaan) orang-orang yang berdosa,","footnotes":""},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\"","footnotes":""},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,","footnotes":""},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"dan kami (juga) tidak memberi makan orang miskin,","footnotes":""},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"bahkan kami biasa berbincang (untuk tujuan yang batil), bersama orang-orang yang membicarakannya,","footnotes":""},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"dan kami mendustakan hari pembalasan,","footnotes":""},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"sampai datang kepada kami kematian.\"","footnotes":""},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Maka tidak berguna lagi bagi mereka syafaat (pertolongan) dari orang-orang yang memberikan syafaat.","footnotes":""},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Lalu mengapa mereka (orang-orang kafir) berpaling dari peringatan (Allah)?","footnotes":""},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"seakan-akan mereka keledai liar yang lari terkejut,","footnotes":""},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"lari dari singa.","footnotes":""},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"Bahkan setiap orang dari mereka ingin agar diberikan kepadanya lembaran-lembaran (kitab) yang terbuka.","footnotes":""},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Tidak! Sebenarnya mereka tidak takut kepada akhirat.","footnotes":""},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Tidak! Sesungguhnya (Al-Qur`an) itu benar-benar suatu peringatan.","footnotes":""},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Maka barangsiapa menghendaki, tentu dia mengambil pelajaran darinya.","footnotes":""},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Dan mereka tidak akan mengambil pelajaran darinya (Al-Qur`an) kecuali (jika) Allah menghendakinya. Dialah Tuhan yang patut (kita) bertakwa kepada-Nya dan yang berhak memberi ampun.","footnotes":""}]}