n yang terbentang luas,","footnotes":""},{"id":"5010","sura":"56","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653\u0621\u0656 \u0645\u0651\u064e\u0633\u06e1\u0643\u064f\u0648\u0628\u0656","translation":"dan air yang mengalir terus-menerus,","footnotes":""},{"id":"5011","sura":"56","aya":"32","arabic_text":"\u0648\u064e\u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0656 \u0643\u064e\u062b\u0650\u064a\u0631\u064e\u0629\u0656","translation":"dan buah-buahan yang banyak,","footnotes":""},{"id":"5012","sura":"56","aya":"33","arabic_text":"\u0644\u0651\u064e\u0627 \u0645\u064e\u0642\u06e1\u0637\u064f\u0648\u0639\u064e\u0629\u0656 \u0648\u064e\u0644\u064e\u0627 \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0639\u064e\u0629\u0656","translation":"yang tidak berhenti berbuah dan tidak terlarang mengambilnya,","footnotes":""},{"id":"5013","sura":"56","aya":"34","arabic_text":"\u0648\u064e\u0641\u064f\u0631\u064f\u0634\u0656 \u0645\u0651\u064e\u0631\u06e1\u0641\u064f\u0648\u0639\u064e\u0629\u064d","translation":"dan kasur-kasur yang tebal lagi empuk.","footnotes":""},{"id":"5014","sura":"56","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0634\u064e\u0623\u06e1\u0646\u064e\u0670\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0634\u064e\u0627\u0653\u0621\u0657","translation":"Kami menciptakan mereka (bidadari-bidadari itu) secara langsung,[828]","footnotes":"[828] Mereka diciptakan tanpa melalui kelahiran dan langsung menjadi gadis."},{"id":"5015","sura":"56","aya":"36","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f\u0646\u0651\u064e \u0623\u064e\u0628\u06e1\u0643\u064e\u0627\u0631\u064b\u0627","translation":"lalu Kami jadikan mereka perawan-perawan,","footnotes":""},{"id":"5016","sura":"56","aya":"37","arabic_text":"\u0639\u064f\u0631\u064f\u0628\u064b\u0627 \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"yang penuh cinta (dan) sebaya umurnya,","footnotes":""},{"id":"5017","sura":"56","aya":"38","arabic_text":"\u0644\u0651\u0650\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"untuk golongan kanan,","footnotes":""},{"id":"5018","sura":"56","aya":"39","arabic_text":"\u062b\u064f\u0644\u0651\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"segolongan besar dari orang-orang yang terdahulu,","footnotes":""},{"id":"5019","sura":"56","aya":"40","arabic_text":"\u0648\u064e\u062b\u064f\u0644\u0651\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"dan segolongan besar pula dari orang yang kemudian.","footnotes":""},{"id":"5020","sura":"56","aya":"41","arabic_text":"\u0648\u064e\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650","translation":"Dan golongan kiri, alangkah sengsaranya golongan kiri itu.","footnotes":""},{"id":"5021","sura":"56","aya":"42","arabic_text":"\u0641\u0650\u064a \u0633\u064e\u0645\u064f\u0648\u0645\u0656 \u0648\u064e\u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"(Mereka) dalam siksaan angin yang sangat panas dan air yang mendidih,","footnotes":""},{"id":"5022","sura":"56","aya":"43","arabic_text":"\u0648\u064e\u0638\u0650\u0644\u0651\u0656 \u0645\u0651\u0650\u0646 \u064a\u064e\u062d\u06e1\u0645\u064f\u0648\u0645\u0656","translation":"dan naungan asap yang hitam,","footnotes":""},{"id":"5023","sura":"56","aya":"44","arabic_text":"\u0644\u0651\u064e\u0627 \u0628\u064e\u0627\u0631\u0650\u062f\u0656 \u0648\u064e\u0644\u064e\u0627 \u0643\u064e\u0631\u0650\u064a\u0645\u064d","translation":"tidak sejuk dan tidak menyenangkan.","footnotes":""},{"id":"5024","sura":"56","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0642\u064e\u0628\u06e1\u0644\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064f\u062a\u06e1\u0631\u064e\u0641\u0650\u064a\u0646\u064e","translation":"Sesungguhnya mereka sebelum itu (dahulu) hidup bermewah-mewah,","footnotes":""},{"id":"5025","sura":"56","aya":"46","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0635\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u062d\u0650\u0646\u062b\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"dan mereka terus-menerus mengerjakan dosa yang besar,","footnotes":""},{"id":"5026","sura":"56","aya":"47","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0623\u064e\u0626\u0650\u0630\u064e\u0627 \u0645\u0650\u062a\u06e1\u0646\u064e\u0627 \u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u062a\u064f\u0631\u064e\u0627\u0628\u0657\u0627 \u0648\u064e\u0639\u0650\u0638\u064e\u0670\u0645\u064b\u0627 \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0628\u06e1\u0639\u064f\u0648\u062b\u064f\u0648\u0646\u064e","translation":"dan mereka berkata, \"Apabila kami sudah mati, menjadi tanah dan tulang-belulang, apakah kami benar-benar akan dibangkitkan kembali?","footnotes":""},{"id":"5027","sura":"56","aya":"48","arabic_text":"\u0623\u064e\u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Apakah nenek moyang kami yang terdahulu (dibangkitkan pula)?\"","footnotes":""},{"id":"5028","sura":"56","aya":"49","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"Katakanlah, \"(Ya), sesungguhnya orang-orang yang terdahulu dan yang kemudian,","footnotes":""},{"id":"5029","sura":"56","aya":"50","arabic_text":"\u0644\u064e\u0645\u064e\u062c\u06e1\u0645\u064f\u0648\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u0650\u064a\u0642\u064e\u0670\u062a\u0650 \u064a\u064e\u0648\u06e1\u0645\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"semuanya pasti akan dikumpulkan pada waktu tertentu, pada hari yang sudah dimaklumi.","footnotes":""},{"id":"5030","sura":"56","aya":"51","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Kemudian sesungguhnya kamu, wahai orang-orang yang sesat lagi mendustakan!","footnotes":""},{"id":"5031","sura":"56","aya":"52","arabic_text":"\u0644\u064e\u0623\u0653\u0643\u0650\u0644\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0634\u064e\u062c\u064e\u0631\u0656 \u0645\u0651\u0650\u0646 \u0632\u064e\u0642\u0651\u064f\u0648\u0645\u0656","translation":"pasti akan memakan pohon zaqqum,[829]","footnotes":"[829] Jenis pohon di neraka yang mengakibatkan derita yang luar biasa bagi yang memakannya."},{"id":"5032","sura":"56","aya":"53","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650\u0640\u0654\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0671\u0644\u06e1\u0628\u064f\u0637\u064f\u0648\u0646\u064e","translation":"Maka akan penuh perutmu dengannya.","footnotes":""},{"id":"5033","sura":"56","aya":"54","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u0645\u0650","translation":"Setelah itu kamu akan memimun air yang sangat panas.","footnotes":""},{"id":"5034","sura":"56","aya":"55","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0634\u064f\u0631\u06e1\u0628\u064e \u0671\u0644\u06e1\u0647\u0650\u064a\u0645\u0650","translation":"Maka kamu minum seperti unta (yang sangat haus) minum.","footnotes":""},{"id":"5035","sura":"56","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064f\u0632\u064f\u0644\u064f\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Itulah hidangan untuk mereka pada hari pembalasan.\"","footnotes":""},{"id":"5036","sura":"56","aya":"57","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Kami telah menciptakan kamu, mengapa kamu tidak membenarkan (hari berbangkit)?","footnotes":""},{"id":"5037","sura":"56","aya":"58","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064f\u0648\u0646\u064e","translation":"Maka adakah kamu perhatikan, tentang (benih manusia) yang kamu pancarkan.","footnotes":""},{"id":"5038","sura":"56","aya":"59","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u062e\u06e1\u0644\u064f\u0642\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u062e\u064e\u0670\u0644\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Kamukah yang menciptakannya, ataukah Kami penciptanya?","footnotes":""},{"id":"5039","sura":"56","aya":"60","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u0642\u064e\u062f\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"Kami telah menentukan kematian masing-masing kamu dan Kami tidak lemah,","footnotes":""},{"id":"5040","sura":"56","aya":"61","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u0623\u064e\u0645\u06e1\u062b\u064e\u0670\u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0646\u064f\u0646\u0634\u0650\u0626\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"untuk menggantikan kamu dengan orang-orang yang seperti kamu (di dunia) dan membangkitkan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui.","footnotes":""},{"id":"5041","sura":"56","aya":"62","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0639\u064e\u0644\u0650\u0645\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"Dan sungguh, kamu telah tahu penciptaan yang pertama, mengapa kamu tidak mengambil pelajaran?","footnotes":""},{"id":"5042","sura":"56","aya":"63","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064e\u062d\u06e1\u0631\u064f\u062b\u064f\u0648\u0646\u064e","translation":"Pernahkah kamu perhatikan benih yang kamu tanam?","footnotes":""},{"id":"5043","sura":"56","aya":"64","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0632\u06e1\u0631\u064e\u0639\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u0632\u0651\u064e\u0670\u0631\u0650\u0639\u064f\u0648\u0646\u064e","translation":"Kamukah yang menumbuhkannya ataukah Kami yang menumbuhkan?","footnotes":""},{"id":"5044","sura":"56","aya":"65","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0644\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u062d\u064f\u0637\u064e\u0670\u0645\u0657\u0627 \u0641\u064e\u0638\u064e\u0644\u06e1\u062a\u064f\u0645\u06e1 \u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0647\u064f\u0648\u0646\u064e","translation":"Sekiranya Kami kehendaki, niscaya Kami hancurkan sampai lumat; maka kamu akan heran tercengang,","footnotes":""},{"id":"5045","sura":"56","aya":"66","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064f\u063a\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"(sambil berkata), \"Sungguh, kami benar-benar menderita kerugian,","footnotes":""},{"id":"5046","sura":"56","aya":"67","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"bahkan kami tidak mendapat hasil apa pun.\"","footnotes":""},{"id":"5047","sura":"56","aya":"68","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Pernahkah kamu memperhatikan air yang kamu minum?","footnotes":""},{"id":"5048","sura":"56","aya":"69","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0632\u06e1\u0646\u0650 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0632\u0650\u0644\u064f\u0648\u0646\u064e","translation":"Kamukah yang menurunkannya dari awan ataukah Kami yang menurunkan?","footnotes":""},{"id":"5049","sura":"56","aya":"70","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0623\u064f\u062c\u064e\u0627\u062c\u0657\u0627 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0634\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e","translation":"Sekiranya Kami menghendaki, niscaya Kami menjadikannya asin, mengapa kamu tidak bersyukur?","footnotes":""},{"id":"5050","sura":"56","aya":"71","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064e \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u0648\u0631\u064f\u0648\u0646\u064e","translation":"Maka pernahkah kamu memperhatikan tentang api yang kamu nyalakan (dengan kayu)?","footnotes":""},{"id":"5051","sura":"56","aya":"72","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u06e1\u062a\u064f\u0645\u06e1 \u0634\u064e\u062c\u064e\u0631\u064e\u062a\u064e\u0647\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0634\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"Kamukah yang menumbuhkan kayu itu ataukah Kami yang menumbuhkan?","footnotes":""},{"id":"5052","sura":"56","aya":"73","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0657 \u0648\u064e\u0645\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0642\u06e1\u0648\u0650\u064a\u0646\u064e","translation":"Kami menjadikannya (api itu) untuk peringatan dan bahan yang berguna bagi musafir.","footnotes":""},{"id":"5053","sura":"56","aya":"74","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar.","footnotes":""},{"id":"5054","sura":"56","aya":"75","arabic_text":"\u06de\u00a0\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0648\u064e\u0670\u0642\u0650\u0639\u0650 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u0650","translation":"Lalu Aku bersumpah dengan tempat beredarnya bintang-bintang.","footnotes":""},{"id":"5055","sura":"56","aya":"76","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0633\u064e\u0645\u065e \u0644\u0651\u064e\u0648\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0639\u064e\u0638\u0650\u064a\u0645\u064c","translation":"Dan sesungguhnya itu benar-benar sumpah yang besar sekiranya kamu mengetahui,","footnotes":""},{"id":"5056","sura":"56","aya":"77","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0643\u064e\u0631\u0650\u064a\u0645\u065e","translation":"dan (ini) sesungguhnya Al-Qur`an yang sangat mulia,","footnotes":""},{"id":"5057","sura":"56","aya":"78","arabic_text":"\u0641\u0650\u064a \u0643\u0650\u062a\u064e\u0670\u0628\u0656 \u0645\u0651\u064e\u0643\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"dalam Kitab yang terpelihara (Lau\u1e25 Ma\u1e25f\u016b\u1e93),","footnotes":""},{"id":"5058","sura":"56","aya":"79","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0645\u064e\u0633\u0651\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"tidak ada yang menyentuhnya selain hamba-hamba yang disucikan.","footnotes":""},{"id":"5059","sura":"56","aya":"80","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Diturunkan dari Tuhan seluruh alam.","footnotes":""},{"id":"5060","sura":"56","aya":"81","arabic_text":"\u0623\u064e\u0641\u064e\u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u0623\u064e\u0646\u062a\u064f\u0645 \u0645\u0651\u064f\u062f\u06e1\u0647\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Apakah kamu menganggap remeh berita ini (Al-Qur`an)?","footnotes":""},{"id":"5061","sura":"56","aya":"82","arabic_text":"\u0648\u064e\u062a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"dan kamu menjadikan rezeki yang kamu terima (dari Allah) justru untuk mendustakan(-Nya).","footnotes":""},{"id":"5062","sura":"56","aya":"83","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u06e1\u062d\u064f\u0644\u06e1\u0642\u064f\u0648\u0645\u064e","translation":"Maka kalau begitu mengapa (tidak mencegah) ketika (nyawa) telah sampai di kerongkongan,","footnotes":""},{"id":"5063","sura":"56","aya":"84","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062d\u0650\u064a\u0646\u064e\u0626\u0650\u0630\u0656 \u062a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"dan kamu ketika itu melihat,","footnotes":""},{"id":"5064","sura":"56","aya":"85","arabic_text":"\u0648\u064e\u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0642\u06e1\u0631\u064e\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0644\u0651\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"dan Kami lebih dekat kepadanya daripada kamu, tetapi kamu tidak melihat,","footnotes":""},{"id":"5065","sura":"56","aya":"86","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064e \u0645\u064e\u062f\u0650\u064a\u0646\u0650\u064a\u0646\u064e","translation":"maka mengapa jika kamu memang tidak dikuasai (oleh Allah),","footnotes":""},{"id":"5066","sura":"56","aya":"87","arabic_text":"\u062a\u064e\u0631\u06e1\u062c\u0650\u0639\u064f\u0648\u0646\u064e\u0647\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"kamu tidak mengembalikannya (nyawa itu) jika kamu orang yang benar?","footnotes":""},{"id":"5067","sura":"56","aya":"88","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u0650\u064a\u0646\u064e","translation":"Jika dia (orang yang mati) itu termasuk yang didekatkan (kepada Allah),","footnotes":""},{"id":"5068","sura":"56","aya":"89","arabic_text":"\u0641\u064e\u0631\u064e\u0648\u06e1\u062d\u065e \u0648\u064e\u0631\u064e\u064a\u06e1\u062d\u064e\u0627\u0646\u065e \u0648\u064e\u062c\u064e\u0646\u0651\u064e\u062a\u064f \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"maka dia memperoleh ketenteraman dan rezeki serta surga (yang penuh) kenikmatan.","footnotes":""},{"id":"5069","sura":"56","aya":"90","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Dan jika dia termasuk golongan kanan,","footnotes":""},{"id":"5070","sura":"56","aya":"91","arabic_text":"\u0641\u064e\u0633\u064e\u0644\u064e\u0670\u0645\u065e \u0644\u0651\u064e\u0643\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"maka, \"Salam bagimu (wahai) dari golongan kanan!\" (sambut malaikat).","footnotes":""},{"id":"5071","sura":"56","aya":"92","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Namun jika dia termasuk golongan yang mendustakan dan sesat,","footnotes":""},{"id":"5072","sura":"56","aya":"93","arabic_text":"\u0641\u064e\u0646\u064f\u0632\u064f\u0644\u065e \u0645\u0651\u0650\u0646\u06e1 \u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"maka dia disambut siraman air yang mendidih,","footnotes":""},{"id":"5073","sura":"56","aya":"94","arabic_text":"\u0648\u064e\u062a\u064e\u0635\u06e1\u0644\u0650\u064a\u064e\u0629\u064f \u062c\u064e\u062d\u0650\u064a\u0645\u064d","translation":"dan dibakar di dalam neraka.","footnotes":""},{"id":"5074","sura":"56","aya":"95","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0644\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"Sungguh, inilah keyakinan yang benar.","footnotes":""},{"id":"5075","sura":"56","aya":"96","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar.","footnotes":""}]}