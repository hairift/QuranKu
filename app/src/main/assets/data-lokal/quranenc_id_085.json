f\u0648\u062f\u065e","translation":"sedang mereka menyaksikan apa yang mereka perbuat terhadap orang-orang mukmin.","footnotes":""},{"id":"5917","sura":"85","aya":"8","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u0642\u064e\u0645\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0639\u064e\u0632\u0650\u064a\u0632\u0650 \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u062f\u0650","translation":"Dan mereka menyiksa orang-orang mukmin itu hanya karena (orang-orang mukmin itu) beriman kepada Allah Yang Mahaperkasa, Maha Terpuji,","footnotes":""},{"id":"5918","sura":"85","aya":"9","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0644\u064e\u0647\u064f\u06e5 \u0645\u064f\u0644\u06e1\u0643\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0656 \u0634\u064e\u0647\u0650\u064a\u062f\u064c","translation":"yang memiliki kerajaan langit dan bumi. Dan Allah Maha Menyaksikan segala sesuatu.","footnotes":""},{"id":"5919","sura":"85","aya":"10","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u064e\u062a\u064e\u0646\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064e\u0670\u062a\u0650 \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0645\u06e1 \u064a\u064e\u062a\u064f\u0648\u0628\u064f\u0648\u0627\u0652 \u0641\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u0648\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u0671\u0644\u06e1\u062d\u064e\u0631\u0650\u064a\u0642\u0650","translation":"Sungguh, orang-orang yang mendatangkan cobaan (bencana, membunuh, menyiksa) kepada orang-orang mukmin laki-laki dan perempuan lalu mereka tidak bertobat, maka mereka akan mendapat azab Jahanam dan mereka akan mendapat azab (neraka) yang membakar.","footnotes":""},{"id":"5920","sura":"85","aya":"11","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u065e \u062a\u064e\u062c\u06e1\u0631\u0650\u064a \u0645\u0650\u0646 \u062a\u064e\u062d\u06e1\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0646\u06e1\u0647\u064e\u0670\u0631\u064f\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0641\u064e\u0648\u06e1\u0632\u064f \u0671\u0644\u06e1\u0643\u064e\u0628\u0650\u064a\u0631\u064f","translation":"Sungguh, orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat surga yang mengalir di bawahnya sungai-sungai, itulah kemenangan yang agung.","footnotes":""},{"id":"5921","sura":"85","aya":"12","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0628\u064e\u0637\u06e1\u0634\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0644\u064e\u0634\u064e\u062f\u0650\u064a\u062f\u064c","translation":"Sungguh, azab Tuhanmu sangat keras.","footnotes":""},{"id":"5922","sura":"85","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u064a\u064f\u0628\u06e1\u062f\u0650\u0626\u064f \u0648\u064e\u064a\u064f\u0639\u0650\u064a\u062f\u064f","translation":"Sungguh, Dialah yang memulai penciptaan (makhluk) dan yang menghidupkannya (kembali).","footnotes":""},{"id":"5923","sura":"85","aya":"14","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u063a\u064e\u0641\u064f\u0648\u0631\u064f \u0671\u0644\u06e1\u0648\u064e\u062f\u064f\u0648\u062f\u064f","translation":"Dan Dialah Yang Maha Pengampun, Maha Pengasih,","footnotes":""},{"id":"5924","sura":"85","aya":"15","arabic_text":"\u0630\u064f\u0648 \u0671\u0644\u06e1\u0639\u064e\u0631\u06e1\u0634\u0650 \u0671\u0644\u06e1\u0645\u064e\u062c\u0650\u064a\u062f\u064f","translation":"Yang memiliki Arasy, lagi Mahamulia,","footnotes":""},{"id":"5925","sura":"85","aya":"16","arabic_text":"\u0641\u064e\u0639\u0651\u064e\u0627\u0644\u065e \u0644\u0651\u0650\u0645\u064e\u0627 \u064a\u064f\u0631\u0650\u064a\u062f\u064f","translation":"Mahakuasa berbuat apa yang Dia kehendaki.","footnotes":""},{"id":"5926","sura":"85","aya":"17","arabic_text":"\u0647\u064e\u0644\u06e1 \u0623\u064e\u062a\u064e\u0649\u0670\u0643\u064e \u062d\u064e\u062f\u0650\u064a\u062b\u064f \u0671\u0644\u06e1\u062c\u064f\u0646\u064f\u0648\u062f\u0650","translation":"Sudahkah sampai kepadamu berita tentang bala tentara (penentang),","footnotes":""},{"id":"5927","sura":"85","aya":"18","arabic_text":"\u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e","translation":"(yaitu) Fir'aun dan Samud?","footnotes":""},{"id":"5928","sura":"85","aya":"19","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u062a\u064e\u0643\u06e1\u0630\u0650\u064a\u0628\u0656","translation":"Memang orang-orang kafir (selalu) mendustakan,","footnotes":""},{"id":"5929","sura":"85","aya":"20","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u0650\u0646 \u0648\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0647\u0650\u0645 \u0645\u0651\u064f\u062d\u0650\u064a\u0637\u064f\u06e2","translation":"padahal Allah mengepung dari belakang mereka (sehingga tidak dapat lolos).","footnotes":""},{"id":"5930","sura":"85","aya":"21","arabic_text":"\u0628\u064e\u0644\u06e1 \u0647\u064f\u0648\u064e \u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0645\u0651\u064e\u062c\u0650\u064a\u062f\u065e","translation":"Bahkan (yang didustakan itu) ialah Al-Qur`an yang mulia,","footnotes":""},{"id":"5931","sura":"85","aya":"22","arabic_text":"\u0641\u0650\u064a \u0644\u064e\u0648\u06e1\u062d\u0656 \u0645\u0651\u064e\u062d\u06e1\u0641\u064f\u0648\u0638\u0650\u06ed","translation":"yang (tersimpan) dalam (tempat) yang terjaga (Lau\u1e25 Ma\u1e25f\u016b\u1e93).","footnotes":""}]}