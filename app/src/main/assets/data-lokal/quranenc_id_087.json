:"\u0635\u064f\u062d\u064f\u0641\u0650 \u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0648\u064e\u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"(yaitu) kitab-kitab Ibrahim dan Musa.","footnotes":""}]}