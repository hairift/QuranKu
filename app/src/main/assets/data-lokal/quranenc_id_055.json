4e\u0644\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0643\u06e1\u0631\u064e\u0627\u0645\u0650","translation":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal.","footnotes":""},{"id":"4929","sura":"55","aya":"28","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4930","sura":"55","aya":"29","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u06e5 \u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0643\u064f\u0644\u0651\u064e \u064a\u064e\u0648\u06e1\u0645\u064d \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0634\u064e\u0623\u06e1\u0646\u0656","translation":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan.[821]","footnotes":"[821] Allah senantiasa menciptakan, menghidupkan, mematikan, memelihara, memberi rezeki dan lain-lain."},{"id":"4931","sura":"55","aya":"30","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4932","sura":"55","aya":"31","arabic_text":"\u0633\u064e\u0646\u064e\u0641\u06e1\u0631\u064f\u063a\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e \u0671\u0644\u062b\u0651\u064e\u0642\u064e\u0644\u064e\u0627\u0646\u0650","translation":"Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!","footnotes":""},{"id":"4933","sura":"55","aya":"32","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4934","sura":"55","aya":"33","arabic_text":"\u064a\u064e\u0670\u0645\u064e\u0639\u06e1\u0634\u064e\u0631\u064e \u0671\u0644\u06e1\u062c\u0650\u0646\u0651\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u0650 \u0625\u0650\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0639\u06e1\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1 \u0623\u064e\u0642\u06e1\u0637\u064e\u0627\u0631\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0641\u064e\u0671\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652\u06da \u0644\u064e\u0627 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0656","translation":"Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah).","footnotes":""},{"id":"4935","sura":"55","aya":"34","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4936","sura":"55","aya":"35","arabic_text":"\u064a\u064f\u0631\u06e1\u0633\u064e\u0644\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064e\u0627 \u0634\u064f\u0648\u064e\u0627\u0638\u065e \u0645\u0651\u0650\u0646 \u0646\u0651\u064e\u0627\u0631\u0656 \u0648\u064e\u0646\u064f\u062d\u064e\u0627\u0633\u065e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u062a\u064e\u0635\u0650\u0631\u064e\u0627\u0646\u0650","translation":"Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya).","footnotes":""},{"id":"4937","sura":"55","aya":"36","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4938","sura":"55","aya":"37","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0648\u064e\u0631\u06e1\u062f\u064e\u0629\u0657 \u0643\u064e\u0671\u0644\u062f\u0651\u0650\u0647\u064e\u0627\u0646\u0650","translation":"Maka apabila langit telah terbelah dan menjadi merah mawar seperti (kilauan) minyak.","footnotes":""},{"id":"4939","sura":"55","aya":"38","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4940","sura":"55","aya":"39","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u0639\u064e\u0646 \u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u06e6\u0653 \u0625\u0650\u0646\u0633\u065e \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Maka pada hari itu manusia dan jin tidak ditanya tentang dosanya.[822]","footnotes":"[822] Tetapi pada saatnya akan dimintai pertanggungjawaban atas segala amal perbuatannya."},{"id":"4941","sura":"55","aya":"40","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4942","sura":"55","aya":"41","arabic_text":"\u064a\u064f\u0639\u06e1\u0631\u064e\u0641\u064f \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0628\u0650\u0633\u0650\u064a\u0645\u064e\u0670\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064f\u0624\u06e1\u062e\u064e\u0630\u064f \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0648\u064e\u0670\u0635\u0650\u064a \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0642\u06e1\u062f\u064e\u0627\u0645\u0650","translation":"Orang-orang yang berdosa itu diketahui dengan tanda-tandanya, lalu direnggut ubun-ubun dan kakinya.","footnotes":""},{"id":"4943","sura":"55","aya":"42","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4944","sura":"55","aya":"43","arabic_text":"\u0647\u064e\u0670\u0630\u0650\u0647\u0650\u06e6 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064f \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Inilah neraka Jahanam yang didustakan oleh orang-orang yang berdosa.","footnotes":""},{"id":"4945","sura":"55","aya":"44","arabic_text":"\u064a\u064e\u0637\u064f\u0648\u0641\u064f\u0648\u0646\u064e \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u06e1\u0646\u064e \u062d\u064e\u0645\u0650\u064a\u0645\u064d \u0621\u064e\u0627\u0646\u0656","translation":"Mereka berkeliling di sana dan di antara air yang mendidih.","footnotes":""},{"id":"4946","sura":"55","aya":"45","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4947","sura":"55","aya":"46","arabic_text":"\u0648\u064e\u0644\u0650\u0645\u064e\u0646\u06e1 \u062e\u064e\u0627\u0641\u064e \u0645\u064e\u0642\u064e\u0627\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u062c\u064e\u0646\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"Dan bagi siapa yang takut akan saat menghadap Tuhannya ada dua surga.[823]","footnotes":"[823] Surga untuk manusia dan surga untuk jin. Ada juga mufasir yang berpendapat surga dunia dan surga akhirat."},{"id":"4948","sura":"55","aya":"47","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4949","sura":"55","aya":"48","arabic_text":"\u0630\u064e\u0648\u064e\u0627\u062a\u064e\u0627\u0653 \u0623\u064e\u0641\u06e1\u0646\u064e\u0627\u0646\u0656","translation":"Kedua surga itu mempunyai aneka pepohonan dan buah-buahan.","footnotes":""},{"id":"4950","sura":"55","aya":"49","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4951","sura":"55","aya":"50","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0639\u064e\u064a\u06e1\u0646\u064e\u0627\u0646\u0650 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a\u064e\u0627\u0646\u0650","translation":"Di dalam kedua surga itu ada dua buah mata air yang memancar.","footnotes":""},{"id":"4952","sura":"55","aya":"51","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4953","sura":"55","aya":"52","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0645\u0650\u0646 \u0643\u064f\u0644\u0651\u0650 \u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0656 \u0632\u064e\u0648\u06e1\u062c\u064e\u0627\u0646\u0650","translation":"Di dalam kedua surga itu terdapat aneka buah-buahan yang berpasang-pasangan.","footnotes":""},{"id":"4954","sura":"55","aya":"53","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4955","sura":"55","aya":"54","arabic_text":"\u0645\u064f\u062a\u0651\u064e\u0643\u0650\u0640\u0654\u0650\u064a\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0641\u064f\u0631\u064f\u0634\u0650\u06ed \u0628\u064e\u0637\u064e\u0627\u0653\u0626\u0650\u0646\u064f\u0647\u064e\u0627 \u0645\u0650\u0646\u06e1 \u0625\u0650\u0633\u06e1\u062a\u064e\u0628\u06e1\u0631\u064e\u0642\u0656\u06da \u0648\u064e\u062c\u064e\u0646\u064e\u0649 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u062a\u064e\u064a\u06e1\u0646\u0650 \u062f\u064e\u0627\u0646\u0656","translation":"Mereka bersandar di atas permadani yang bagian dalamnya dari sutera tebal. Dan buah-buahan di kedua surga itu dapat (dipetik) dari dekat.","footnotes":""},{"id":"4956","sura":"55","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?","footnotes":""},{"id":"4957","sura":"55","aya":"56","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0646\u0651\u064e \u0642\u064e\u0670\u0635\u0650\u0631\u064e\u0670\u062a\u064f \u0671\u0644\u0637\u0651\u064e\u0631\u06e1\u0641\u0650 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0637\u06e1\u0645\u0650\u062b\u06e1\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0633\u065e \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Di dalam surga itu ada bidadari-bidadari yang membatasi pandangan, yang tidak pernah disentuh oleh manusia maupun jin sebelumnya.","footnotes":""},{"id":"4958","sura":"55","aya":"57","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\